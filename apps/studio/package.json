{
  "name": "aide-skill-studio",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "catalog": "node ../../scripts/build-studio-catalog.mjs",
    "build": "npm run catalog && tsc --noEmit && vite build",
    "start": "node server/start.mjs --open",
    "serve": "node server/start.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
