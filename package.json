{
  "name": "ai-design-engineer",
  "version": "1.1.0",
  "private": true,
  "description": "Open-source framework + skills for AI-assisted design engineering. From idea → UX → UI → production code.",
  "keywords": [
    "ai",
    "design",
    "ui",
    "ux",
    "claude-code",
    "cursor",
    "windsurf",
    "skills",
    "framework",
    "design-system",
    "design-engineering"
  ],
  "license": "MIT",
  "author": "gamemun01",
  "homepage": "https://github.com/gamemun01/ai-design-engineer",
  "repository": {
    "type": "git",
    "url": "https://github.com/gamemun01/ai-design-engineer.git"
  },
  "bugs": {
    "url": "https://github.com/gamemun01/ai-design-engineer/issues"
  },
  "bin": {
    "create-ai-design-engineer": "scripts/create-ai-design-engineer.js"
  },
  "scripts": {
    "lint:md": "node scripts/lint-all.js",
    "lint": "npm run lint:md",
    "validate-skill": "node scripts/validate-skill.js",
    "check-links": "node scripts/check-links.js",
    "create": "node scripts/create-ai-design-engineer.js",
    "plugins": "node scripts/plugin-cli.js",
    "validate-plugin": "node scripts/validate-plugin.js",
    "test": "node tests/scaffolder.test.js && node tests/skills.test.js && node tests/plugins.test.js",
    "test:skills": "node tests/skills.test.js",
    "test:plugins": "node tests/plugins.test.js",
    "docs:serve": "cd docs-site && mkdocs serve",
    "docs:build": "cd docs-site && mkdocs build",
    "docs:deploy": "cd docs-site && mkdocs gh-deploy --force",
    "preview": "npx serve ."
  },
  "devDependencies": {
    "markdownlint-cli": "^0.49.0",
    "serve": "^14.2.0"
  }
}
