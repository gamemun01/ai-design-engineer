{
  "name": "ai-design-engineer",
  "version": "1.2.0",
  "private": true,
  "description": "Open-source framework + skills for AI-assisted design engineering. From idea → UX → UI → production code.",
  "keywords": [
    "ai",
    "design",
    "ui",
    "ux",
    "claude-code",
    "cursor",
    "windsurf",
    "skills",
    "framework",
    "design-system",
    "design-engineering"
  ],
  "license": "MIT",
  "author": "gamemun01",
  "homepage": "https://github.com/gamemun01/ai-design-engineer",
  "repository": {
    "type": "git",
    "url": "https://github.com/gamemun01/ai-design-engineer.git"
  },
  "bugs": {
    "url": "https://github.com/gamemun01/ai-design-engineer/issues"
  },
  "bin": {
    "create-ai-design-engineer": "scripts/create-ai-design-engineer.js"
  },
  "scripts": {
    "lint:md": "node scripts/lint-all.js",
    "lint": "npm run lint:md",
    "validate-skill": "node scripts/validate-skill.js",
    "check-links": "node scripts/check-links.js",
    "create": "node scripts/create-ai-design-engineer.js",
    "plugins": "node scripts/plugin-cli.js",
    "validate-plugin": "node scripts/validate-plugin.js",
    "skills:codex:register": "node scripts/register-codex-skills.js --write",
    "skills:codex:check": "node scripts/register-codex-skills.js --check",
    "studio": "node apps/studio/server/start.mjs --open",
    "studio:serve": "node apps/studio/server/start.mjs",
    "studio:build": "npm --prefix apps/studio run build",
    "studio:test": "npm --prefix apps/studio test",
    "studio:package": "node scripts/package-studio.mjs",
    "test": "node tests/scaffolder.test.js && node tests/skill-integrity.test.js && node tests/codex-registration.test.js && node tests/skills.test.js && node tests/plugins.test.js",
    "test:skills": "node tests/skill-integrity.test.js && node tests/codex-registration.test.js && node tests/skills.test.js",
    "test:plugins": "node tests/plugins.test.js",
    "docs:serve": "cd docs-site && mkdocs serve",
    "docs:build": "cd docs-site && mkdocs build",
    "docs:deploy": "cd docs-site && mkdocs gh-deploy --force",
    "preview": "npx serve ."
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "markdownlint-cli": "^0.50.1",
    "serve": "^14.2.0"
  },
  "overrides": {
    "compression": "^1.8.2",
    "katex": "^0.18.2"
  }
}
